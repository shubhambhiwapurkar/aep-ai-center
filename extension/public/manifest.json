{
  "manifest_version": 3,
  "name": "AEP AI Center",
  "version": "1.0.0",
  "description": "Copilot for Adobe Experience Platform & Journey Optimizer: knows the page you're on, finds anything, audits your sandbox. Metadata only.",
  "minimum_chrome_version": "116",
  "icons": { "128": "icon.png" },
  "action": { "default_title": "Open AEP AI Center", "default_icon": "icon.png" },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js" },
  "permissions": ["sidePanel", "storage", "unlimitedStorage", "tabs"],
  "host_permissions": [
    "http://localhost:3001/*",
    "http://127.0.0.1:3001/*",
    "https://api.openai.com/*",
    "https://api.anthropic.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "storage": { "managed_schema": "managed_schema.json" },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+A", "mac": "Alt+Shift+A" },
      "description": "Open AEP AI Center"
    }
  }
}
